APP_NAME=ReelFetch
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://yourdomain.com
MAX_DURATION_SECONDS=7200
MAX_DOWNLOAD_MB=500
TOKEN_TTL_SECONDS=900
ANALYZE_LIMIT_PER_HOUR=80
DOWNLOAD_LIMIT_PER_HOUR=40
# Optional but often needed when Instagram rate-limits datacenter IPs.
# Export a Netscape-format cookies.txt from an account you are authorized to use,
# then base64-encode the file and store the value only as a server secret.
INSTAGRAM_COOKIES_B64=
